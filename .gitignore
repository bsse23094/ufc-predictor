# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python tooling and test output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.venv/
