# Copy this file to .env for local-only development. Never commit .env files.
# Production configuration is injected through the deployment secret manager.

# Common runtime
APP_ENV=local
RELEASE_SHA=development
IMAGE_DIGEST=
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ufc-predictor-api
OTEL_SAMPLE_RATIO=0.1
REQUEST_ID_HEADER=X-Request-ID

# API, database, and cache
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
DATABASE_URL=postgresql+asyncpg://ufc_predictor:ufc_predictor@127.0.0.1:5432/ufc_predictor
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_PREFIX=ufc_predictor:local
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
RATE_LIMIT_PUBLIC=120/minute
RATE_LIMIT_PREDICTION=20/minute
RATE_LIMIT_SIMULATION=5/minute
MAX_REQUEST_BYTES=1048576
MAX_PAGE_SIZE=100

# Authentication and artifact integrity. These values are intentionally blank locally.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
JWT_REQUIRED_ALGORITHMS=RS256
AUTH_COOKIE_NAME=ufc_predictor_session
CSRF_COOKIE_NAME=ufc_predictor_csrf
MODEL_ARTIFACT_REQUIRE_SIGNATURE=false
MODEL_ARTIFACT_TRUSTED_PREFIXES=
CHAMPION_BUNDLE_PATH=data/processed/m4-final-champion/m3-74eeb9b7f49b5adca45e461a/m4_final_champion_bundle.json
AUDIT_IP_HASH_KEY=

# Object storage and model registry
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
RAW_BUCKET=ufc-predictor-raw
DATA_BUCKET=ufc-predictor-data
MODEL_BUCKET=ufc-predictor-models
OBJECT_STORE_FORCE_PATH_STYLE=true
MLFLOW_TRACKING_URI=
MLFLOW_REGISTRY_URI=
MODEL_CACHE_DIR=.cache/models
MODEL_ALIAS_PURE=champion
MODEL_ALIAS_MARKET=champion
MODEL_ALIAS_METHOD=champion
MODEL_ALIAS_DURATION=champion
MODEL_ALIAS_JUDGING=shadow
MODEL_ALIAS_POLL_SECONDS=60
MODEL_ROLLBACK_CACHE_COUNT=2

# Workers and schedules
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=
CELERY_DEFAULT_QUEUE=maintenance
CELERY_WORKER_CONCURRENCY=1
JOB_RESULT_RETENTION_DAYS=30
ANONYMOUS_SIMULATION_RETENTION_DAYS=30
MONTE_CARLO_DEFAULT_ITERATIONS=10000
MONTE_CARLO_MAX_ITERATIONS=100000
MAX_CONCURRENT_SIMULATIONS_PER_PRINCIPAL=2
SCHEDULE_TIMEZONE=UTC

# Data ingestion. Keep ENABLED_SOURCES empty until source-policy approval.
ENABLED_SOURCES=
SOURCE_USER_AGENT=ufc-predictor/0.1 (+contact-required-before-enable)
SOURCE_CONTACT=
SOURCE_DEFAULT_REQUESTS_PER_MINUTE=30
SOURCE_MAX_CONCURRENCY=1
SOURCE_REQUEST_TIMEOUT_SECONDS=20
SOURCE_MAX_RESPONSE_BYTES=10485760
INGESTION_RAW_ROOT=data/raw
DATA_INTERIM_ROOT=data/interim
DATA_PROCESSED_ROOT=data/processed
DUCKDB_PATH=data/interim/ufc_predictor.duckdb

# Web (NEXT_PUBLIC values are deliberately non-secret.)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RELEASE_SHA=development
INTERNAL_API_BASE_URL=http://api:8000
