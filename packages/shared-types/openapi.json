{
  "components": {
    "schemas": {
      "HealthResponse": {
        "description": "Process-only liveness response.",
        "properties": {
          "release_sha": {
            "title": "Release Sha",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "release_sha"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Foundation readiness response that does not claim unimplemented dependencies are live.",
        "properties": {
          "capabilities": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "object"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "capabilities"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Reproducible pre-fight UFC analytics. Outputs are uncertain estimates, not betting advice.",
    "title": "UFC Predictor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
