  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Service Health & Prediction SLAs",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/api/v1/predictions/matchup\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 Latency (Objective < 1500ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{handler=\"/api/v1/predictions/matchup\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50 Median Latency",
          "refId": "B"
        }
      ],
      "title": "Matchup Prediction Latency (p95 SLA)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "req/min"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"2..\"}[5m])) * 60",
          "legendFormat": "Success (2xx)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m])) * 60",
          "legendFormat": "Client Error / Validation (4xx)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) * 60",
          "legendFormat": "Server Error (5xx)",
          "refId": "C"
        }
      ],
      "title": "API Request Throughput by Status Code",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Cache & Model Governance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
          "refId": "A"
        }
      ],
      "title": "Redis Cache Hit Ratio",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      },
      "targets": [
        {
          "expr": "sum(rate(prediction_confidence_tier_total{tier=\"high\"}[5m])) / sum(rate(prediction_confidence_tier_total[5m])) * 100",
          "legendFormat": "High Confidence Tier",
          "refId": "A"
        },
        {
          "expr": "sum(rate(prediction_confidence_tier_total{tier=\"medium\"}[5m])) / sum(rate(prediction_confidence_tier_total[5m])) * 100",
          "legendFormat": "Medium Confidence Tier",
          "refId": "B"
        },
        {
          "expr": "sum(rate(prediction_confidence_tier_total{tier=\"default\"}[5m])) / sum(rate(prediction_confidence_tier_total[5m])) * 100",
          "legendFormat": "Default / Low Confidence Tier",
          "refId": "C"
        }
      ],
      "title": "Confidence Tier Coverage Distribution",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ufc-predictor", "mlops", "production"],
  "time": { "from": "now-1h", "to": "now" },
