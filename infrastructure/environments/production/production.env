# Production Environment Configuration
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Networking & Security
CORS_ALLOWED_ORIGINS=https://ufcpredictor.com,https://app.ufcpredictor.com
MAX_REQUEST_BYTES=1048576
MAX_PAGE_SIZE=100
RATE_LIMIT_PER_MINUTE=60

# Cache & Storage
CACHE_TTL_SECONDS=3600

# Auth Boundaries - In production these reference secrets manager
ADMIN_API_KEYS=production-admin-key-vault-ref
ANALYST_API_KEYS=production-analyst-key-vault-ref

# Model Runtime
CHAMPION_BUNDLE_PATH=artifacts/champion_m5_bundle.json
