# Staging Environment Configuration
APP_ENV=staging
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Networking & Security
CORS_ALLOWED_ORIGINS=https://staging.ufcpredictor.internal,http://localhost:3000
MAX_REQUEST_BYTES=1048576
MAX_PAGE_SIZE=100
RATE_LIMIT_PER_MINUTE=120

# Cache & Storage
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CACHE_TTL_SECONDS=1800

# Auth Boundaries
ADMIN_API_KEYS=staging-admin-secret-key-audit-99
ANALYST_API_KEYS=staging-analyst-secret-key-eval-42

# Model Runtime
CHAMPION_BUNDLE_PATH=artifacts/champion_m5_bundle.json
